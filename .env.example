# Option B: copy to .env (project root) and/or C:\xampp\secure\barangay_db\.env
# Exact origins only (scheme + host + port). Never use *.

FRONTEND_URL=
FRONTEND_URLS=

# Production deployment (optional)
# APP_ENV=production
# Secure DB config (outside webroot): C:\xampp\secure\barangay_db\barangay_db.php
# Run once: php scripts/harden_security.php
# Daily backup: scripts/daily_backup.bat (Task Scheduler — scripts/register_daily_backup_task.ps1)
# Readiness check: php scripts/production_readiness.php

# Examples:
# FRONTEND_URL=https://app.example.com
# FRONTEND_URLS=https://app.example.com,https://admin.example.com

# SameSite=None + Secure cookies turn on automatically when either value is set.
# Leave empty for local http://192.168.0.69/barangay_default (same-origin).
